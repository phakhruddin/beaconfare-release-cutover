FROM --platform=linux/amd64 mirror.gcr.io/library/python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
# Standard library only: nothing is installed, so the supplied image cannot
# break on a package index and builds in seconds. Each release is one build of
# this file; the version and pricing build are fixed inside the image.
ARG APP_VERSION=0.0.0
ARG PRICING_BUILD=standard
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    APP_VERSION=${APP_VERSION} PRICING_BUILD=${PRICING_BUILD}
WORKDIR /app
COPY awslite.py api.py ./
# Host file modes are not guaranteed; the app user must be able to read the sources.
RUN chmod 0755 /app && chmod 0644 /app/awslite.py /app/api.py
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["python3", "/app/api.py"]

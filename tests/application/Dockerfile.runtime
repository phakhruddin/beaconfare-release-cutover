# Thin image that only needs a Docker CLI: it builds the two application
# images against the host daemon and writes the per-run configuration.
FROM mirror.gcr.io/library/docker:27.5.1-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS runtime-setup
RUN apk add --no-cache coreutils
